# 로컬 개발용 환경변수 예시. 복사해서 사용한다: cp .env.example .env
# .env는 커밋하지 않는다 (.gitignore에 포함됨).

# PostgreSQL (docker-compose와 Spring local 프로파일이 같은 값을 사용)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whattocook
DB_USERNAME=whattocook
DB_PASSWORD=whattocook

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# OpenAI (AI 추천 기능을 실제로 호출할 때만 주석을 풀고 설정한다. 빈 값으로 두면 기동에 실패한다.)
# OPENAI_API_KEY=
