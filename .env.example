# 로컬 개발용 환경변수 예시. 복사해서 사용한다: cp .env.example .env
# .env는 커밋하지 않는다 (.gitignore에 포함됨).

# PostgreSQL (docker-compose와 Spring local 프로파일이 같은 값을 사용)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whattocook
DB_USERNAME=whattocook
DB_PASSWORD=whattocook

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# S3 호환 스토리지 (레시피 이미지). 비워 두면 docker-compose MinIO와 local 프로파일이 로컬 전용 기본값을 쓴다.
# 키는 MinIO 루트 계정으로도 쓰인다 (비밀 키는 8자 이상).
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=
# STORAGE_PUBLIC_BASE_URL=
# prod 전용: STORAGE_REGION

# S3 호환 스토리지 (레시피 이미지). 비워 두면 docker-compose(SeaweedFS)와 local 프로파일이 같은 로컬 전용 기본값을 쓴다.
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=
# STORAGE_PUBLIC_BASE_URL=
# STORAGE_REGION=        (prod 전용)

# JWT 서명 키 (32바이트 이상). 비워 두면 local 프로파일의 로컬 전용 기본값을 쓴다.
# JWT_SECRET=

# OpenAI (AI 추천 기능을 실제로 호출할 때만 주석을 풀고 설정한다. 빈 값으로 두면 기동에 실패한다.)
# OPENAI_API_KEY=
