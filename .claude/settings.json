{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh api *merge*)",
      "Bash(git merge *)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(git push * develop*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  }
}
